# Desk gitignore

# Build outputs
target/
*.class
website/node_modules/
website/dist/
dist/
!dist/.gitkeep

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
~*

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Distribution artifacts (do not commit binaries)
*.exe
*.zip
*.tar.gz
*.jar
!.mvn/maven-wrapper.jar
packaging/**/native/
packaging/**/portable/
