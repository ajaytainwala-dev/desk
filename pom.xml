<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent project for the cross-platform Java developer toolkit.
  Parent POM for the Desk cross-platform Java developer toolkit.
  by changing the <name>, <artifactId>, and version properties in one place.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.desk</groupId>
  <artifactId>desk</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Desk</name>
  <description>
    A lightweight, cross-platform, terminal-native Java developer toolkit.
    Combines a terminal editor, Java source formatter, syntax-highlighting
    engine, source analysis, compilation/execution integration, and a CLI.
  </description>
  <url>https://example.com/desk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Desk Maintainers</name>
      <organization>Desk Project</organization>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ajaytainwala-dev/desk.git</connection>
    <developerConnection>scm:git:https://github.com/ajaytainwala-dev/desk.git</developerConnection>
    <url>https://github.com/ajaytainwala-dev/desk</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- Generic project name. Change here and in module artifactIds to rename. -->
    <project.name>desk</project.name>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Java baseline. The environment provides Java 23; the product baseline
         targets Java 25 LTS once available. Version-specific features are avoided
         so the code compiles on both. -->
    <java.version>23</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- Dependency versions -->
    <slf4j.version>2.0.16</slf4j.version>
    <junit.jupiter.version>5.11.3</junit.jupiter.version>
    <lanterna.version>3.1.5</lanterna.version>

    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.3</maven.surefire.plugin.version>
    <maven.javadoc.plugin.version>3.8.0</maven.javadoc.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.jupiter.version}</version>
      </dependency>
      <dependency>
        <groupId>com.googlecode.lanterna</groupId>
        <artifactId>lanterna</artifactId>
        <version>${lanterna.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <modules>
    <module>modules/desk-core</module>
    <module>modules/desk-cli</module>
    <module>modules/desk-lexer</module>
    <module>modules/desk-syntax</module>
    <module>modules/desk-terminal</module>
    <module>modules/desk-editor</module>
    <module>modules/desk-formatter</module>
    <module>modules/desk-java</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <showWarnings>true</showWarnings>
            <showDeprecation>true</showDeprecation>
            <failOnWarning>false</failOnWarning>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
          <configuration>
            <trimStackTrace>false</trimStackTrace>
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>strict-warnings</id>
      <activation>
        <property><name>env.STRICT_WARNINGS</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
